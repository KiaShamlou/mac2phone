    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {"gsap":"3.15.0","lenis":"1.3.27","react":"19.3.1","react-dom":"19.3.1"},
  "devDependencies": {"vite":"8.3.4"},
  "engines": {"node": ">=22.12.0"}
}
